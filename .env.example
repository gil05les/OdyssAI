# OdyssAI Environment Variables
# Copy this file to .env and fill in your API keys

# =============================================================================
# Amadeus API (Required)
# Sign up at: https://developers.amadeus.com/
# Used for: flights, hotels, car rentals, points of interest
# =============================================================================
AMADEUS_CLIENT_ID=your_amadeus_client_id
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret
# Set to "test" for sandbox or "prod" for production
AMADEUS_ENV=test

# =============================================================================
# OpenAI API (Required)
# Sign up at: https://platform.openai.com/
# Used for: AI agent reasoning and responses
# =============================================================================
OPENAI_API_KEY=your_openai_api_key

# =============================================================================
# Unsplash API (Required)
# Sign up at: https://unsplash.com/developers
# Used for: Destination and activity images
# =============================================================================
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# =============================================================================
# OpenWeatherMap API (Required)
# Sign up at: https://openweathermap.org/api
# Used for: Weather forecasts and best travel season recommendations
# =============================================================================
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key

# =============================================================================
# Yelp API (Required)
# Sign up at: https://www.yelp.com/developers
# Used for: Activity and business search for itinerary generation
# =============================================================================
YELP_API_KEY=your_yelp_api_key

# =============================================================================
# Google Maps API (Required)
# Sign up at: https://console.cloud.google.com/
# Enable: Geocoding API, Directions API
# Used for: Location geocoding and transport directions
# =============================================================================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# =============================================================================
# Optional Configuration
# =============================================================================

# Default LLM model for agents (default: gpt-5.1)
DEFAULT_MODEL=gpt-5.1

# Host project root path (auto-detected by docker-compose, but can be overridden)
# HOST_PROJECT_ROOT=/absolute/path/to/OdyssAI

# OpenRouter API (alternative to OpenAI, optional)
# OPENROUTER_API_KEY=your_openrouter_api_key
